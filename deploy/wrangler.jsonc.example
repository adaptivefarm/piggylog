// Copy to the repo root as wrangler.jsonc, then fill in your own values.
//   cp deploy/wrangler.jsonc.example wrangler.jsonc
{
  "name": "piggylog-dashboard",

  // Your Cloudflare account ID — find it in the Cloudflare dashboard sidebar.
  "account_id": "PUT-YOUR-ACCOUNT-ID-HERE",

  "compatibility_date": "2026-05-01",
  "main": "deploy/worker.js",

  // Serves the repo root, but .assetsignore narrows the upload to index.html
  // only. Everything else — logs, prices, health records — stays local.
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Your own domain. Delete this block to use the free *.workers.dev address.
  "routes": [
    { "pattern": "pigs.example.com", "custom_domain": true }
  ]
}
